# Copie este arquivo para ".env" (opcional — os valores abaixo já são o
# padrão do projeto). Não há nenhum token/API key nesta versão: os modelos
# rodam localmente via Ollama, sem custo e sem credenciais externas.

# Endereço do servidor Ollama local (padrão já funciona na maioria dos casos)
OLLAMA_HOST=http://localhost:11434

# Modelo principal usado pelo agente (precisa ser baixado antes com "ollama pull")
CHARGEGRID_MODEL=qwen3:8b

# Modelo secundário usado apenas na comparação entre modelos (Bloco B)
CHARGEGRID_MODEL_COMPARE=llama3.1:8b
