# Copie este arquivo para ".env" e preencha com seu token real.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).

# Token de leitura da Hugging Face (huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo principal usado pelo agente (ver src/config.py para IDs suportados)
CHARGEGRID_MODEL=deepseek-ai/DeepSeek-V3-0324

# Modelo secundário usado apenas na comparação entre modelos (Bloco B)
CHARGEGRID_MODEL_COMPARE=Qwen/Qwen2.5-72B-Instruct
